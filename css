body {
    margin: 0;
    font-family: "Segoe UI", Arial, sans-serif;
    background-color: #f2f2f2;
    color: #333;
}

/* Hero Banner */
.hero {
    background: linear-gradient(to right, #b30000, #002868);
    color: white;
    text-align: center;
    padding: 70px 20px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}

.hero h1 {
    font-size: 3rem;
    margin-bottom: 10px;
}

.hero p {
    font-size: 1.3rem;
    letter-spacing: 1px;
}

/* Navigation Bar */
nav {
    background: white;
    padding: 12px;
    text-align: center;
    border-bottom: 4px solid #b30000;
}

nav a {
    margin: 0 20px;
    text-decoration: none;
    color: #002868;
    font-weight: bold;
    font-size: 1.1rem;
}

nav a:hover {
    color: #b30000;
}

/* Sections */
section {
    padding: 30px;
    max-width: 900px;
    margin: auto;
}

h2 {
    color: #b30000;
    border-left: 5px solid #002868;
    padding-left: 10px;
    margin-bottom: 15px;
}

/* Mission Statement */
.mission-text {
    font-size: 1.3rem;
    background: white;
    padding: 20px;
    border-left: 5px solid #b30000;
    border-radius: 5px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

/* Footer */
footer {
    text-align: center;
    padding: 20px;
    background: #002868;
    color: white;
    margin-top: 40px;
    font-size: 1.1rem;
}
