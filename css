body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f4f4f4;
}

.hero {
    background: linear-gradient(to right, #b30000, #002868);
    color: white;
    text-align: center;
    padding: 60px 20px;
}

nav {
    background: #ffffff;
    padding: 10px;
    text-align: center;
    border-bottom: 3px solid #b30000;
}

nav a {
    margin: 0 15px;
    text-decoration: none;
    color: #002868;
    font-weight: bold;
}

section {
    padding: 20px;
    max-width: 800px;
    margin: auto;
}

h2 {
    color: #b30000;
}

footer {
    text-align: center;
    padding: 20px;
    background: #002868;
    color: white;
    margin-top: 40px;
}
