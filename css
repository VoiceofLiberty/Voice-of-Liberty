body {
    margin: 0;
    font-family: "Segoe UI", Arial, sans-serif;
    color: #333;

    /* American flag style background */
    background: repeating-linear-gradient(
        to bottom,
        #b30000 0px,
        #b30000 60px,
        white 60px,
        white 120px,
        #b30000 120px,
        #b30000 180px,
        white 180px,
        white 240px
    );
}
